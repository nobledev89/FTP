# FinTechPulse local worker environment template (Windows PC only)
#
# Copy to local-worker/.env.local, fill the five required values, and run
# `pnpm env:check:worker`. Never copy this file or its real values to Vercel.

SUPABASE_URL=http://127.0.0.1:54321
# Grants full database access. Keep the real value only on the worker PC.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
PUBLIC_SITE_URL=http://localhost:3000
# Must exactly match the web app's REVALIDATION_SECRET.
REVALIDATION_SECRET=replace-with-at-least-32-random-characters

# Stable, unique per worker process: lowercase letters, digits, and hyphens.
WORKER_ID=home-pc-1

# Tunables (defaults shown).
WORKER_POLL_INTERVAL_MS=10000
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_OFFLINE_AFTER_SECONDS=120
WORKER_LEASE_SECONDS=900
WORKER_MAX_ATTEMPTS=5
# Time allowed for an active handler to stop after Ctrl+C or scheduled shutdown.
WORKER_SHUTDOWN_TIMEOUT_MS=30000
PUBLISH_VERIFY_TIMEOUT_MS=15000

# Optional non-sensitive dashboard label. Defaults to WORKER_ID; the hostname is not uploaded.
# WORKER_HOST_LABEL=home-pc

# Subscription CLIs. Install and sign in as the Windows account that runs the worker.
# An API-key sign-in is refused. See docs/PROVIDERS.md.
# CODEX_BIN=codex
# CLAUDE_BIN=claude
# CLAUDE_MODEL=opus
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=high
# CLI_TIMEOUT_MS=1200000

# Optional metered API modes. Add only keys for stages explicitly switched to API mode.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_MODEL=gpt-5
# ANTHROPIC_API_MODEL=claude-sonnet-5
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# API_TIMEOUT_MS=300000
# API_MAX_RESPONSE_BYTES=16000000
