# FinTechPulse environment template
#
# Copy the section you need; never commit real values.
#   Web app (local dev):  .env.local in the repository root
#   Web app (Vercel):     Project Settings -> Environment Variables
#   Local worker:         local-worker/.env.local on the Windows PC only
#
# Local Supabase values are printed by `pnpm supabase:start`.

# ---------------------------------------------------------------------------
# Web / Vercel
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash. Used for canonical URLs, sitemap, RSS, and OG tags.
# Production (Vercel): https://fintechpulse.co.uk. Local development: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-safe Supabase settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase URL (same project as above).
SUPABASE_URL=http://127.0.0.1:54321

# Shared secret for the signed /api/revalidate endpoint. At least 32 random characters.
# Generate one with: pnpm node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATION_SECRET=

# The web app does NOT use the Supabase service-role key. Do not add it to Vercel.

# ---------------------------------------------------------------------------
# Local worker (Windows PC only)
# ---------------------------------------------------------------------------

# SUPABASE_URL=http://127.0.0.1:54321
# Service-role secret. Grants full database access: keep it on the worker PC only.
# SUPABASE_SERVICE_ROLE_KEY=
# Production: https://fintechpulse.co.uk
# PUBLIC_SITE_URL=http://localhost:3000
# REVALIDATION_SECRET=

# Stable, unique per worker process: lowercase letters, digits, and hyphens.
# WORKER_ID=home-pc-1

# Tunables (defaults shown).
# WORKER_POLL_INTERVAL_MS=10000
# WORKER_HEARTBEAT_INTERVAL_MS=30000
# WORKER_OFFLINE_AFTER_SECONDS=120
# WORKER_LEASE_SECONDS=900
# WORKER_MAX_ATTEMPTS=5
# Time allowed for an active handler to stop after Ctrl+C or Task Scheduler requests shutdown.
# WORKER_SHUTDOWN_TIMEOUT_MS=30000
# PUBLISH_VERIFY_TIMEOUT_MS=15000

# Optional non-sensitive dashboard label. Defaults to WORKER_ID; the OS hostname is not uploaded.
# WORKER_HOST_LABEL=home-pc

# Subscription CLIs (Phase 9). Each must be installed and signed in on this PC with the
# subscription account: `claude auth login` (Claude subscription) and `codex login` (Sign in with
# ChatGPT). An API-key sign-in is refused. See docs/PROVIDERS.md.
# Each value may be a command on PATH, an absolute path to the .exe, or a .js/.mjs entry point.
# CODEX_BIN=codex
# CLAUDE_BIN=claude
# Optional model overrides; unset uses each CLI's own default.
# CLAUDE_MODEL=opus
# CODEX_MODEL=
# One of minimal, low, medium, high, xhigh; unset uses the model's default.
# CODEX_REASONING_EFFORT=high
# Longest one CLI stage may run before it is killed and retried (default 20 minutes).
# CLI_TIMEOUT_MS=1200000

# ---------------------------------------------------------------------------
# Optional API mode (worker only)
# ---------------------------------------------------------------------------
# Needed only for stages explicitly switched to API mode in the admin. API calls are billed.
# The worker never falls back to these keys from manual or subscription modes.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
